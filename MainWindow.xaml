<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MyDairy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyDairy"
    xmlns:markup="using:MyDairy.Markup"
    xmlns:common="using:MyDairy.Common"
    xmlns:controls="using:MyDairy.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MyDairy">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="MainTitleBar"
                  Height="32" Title="MyDairy"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="OnPaneToggleRequested"
                  BackRequested="OnTitleBarBackRequested">
            <TitleBar.Resources>
                <Thickness x:Key="TitleBarIconMargin">0,0,8,0</Thickness>
                <x:Double x:Key="TitleBarIconMaxWidth">20</x:Double>
                <x:Double x:Key="TitleBarIconMaxHeight">20</x:Double>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <FontIconSource FontFamily="Segoe UI Emoji" Glyph="&#x1F4D3;" FontSize="20" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame x:Name="ContentFrame" Grid.Row="2">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition>
                        <DrillInNavigationTransitionInfo />
                    </NavigationThemeTransition>
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
    </Grid>
</Window>
