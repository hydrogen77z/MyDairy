<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyDairy.Common.Converters">

    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
    <!--<Thickness x:Key="NavigationViewBorderThickness">0</Thickness>-->
    <!--<Thickness x:Key="NavigationViewContentMargin">0,48,0,0</Thickness>-->
    <!--<Thickness x:Key="NavigationViewHeaderMargin">56,34,0,0</Thickness>-->
    <Thickness x:Key="NavigationViewMinimalHeaderMargin">24,34,0,0</Thickness>
    <!--<Thickness x:Key="NavigationViewPageContentMargin">56,18,56,24</Thickness>
    <Thickness x:Key="NavigationViewAutoSuggestBoxMargin">16,0,16,0</Thickness>
    <Thickness x:Key="NavigationViewButtonHolderGridMargin">0,4</Thickness>
    <Thickness x:Key="NavigationViewPaneContentGridMargin">0,3</Thickness>-->

    <x:Double x:Key="ListViewItemMinWidth">40</x:Double>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>
    <x:Double x:Key="CommandBarOverflowMaxWidth">240</x:Double>

    <x:Double x:Key="ToggleSwitchPreContentMargin">8</x:Double>
    <x:Double x:Key="ToggleSwitchPostContentMargin">8</x:Double>

    <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
    <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />

    <Thickness x:Key="PivotHeaderItemMargin">0,0,24,0</Thickness>
    <Thickness x:Key="PivotItemMargin">0,18,0,0</Thickness>

    <Thickness x:Key="AppBarToggleButtonBorderThemeThickness">0</Thickness>
    
    <converters:EnumIntConverter x:Key="EnumIntConverter" />
    <converters:OpacityConverter x:Key="OpacityConverter" />

    <SolidColorBrush x:Key="CustomContentDialogBorderBrush" Color="{ThemeResource SystemAccentColor}" />

    <Style x:Key="DefaultContentDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource CustomContentDialogBorderBrush}" />
    </Style>
</ResourceDictionary>
