<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyDairy.Controls">

    <Thickness x:Key="GroupBoxContentPadding">8,12,8,8</Thickness>
    
    <Style TargetType="local:GroupBox" x:Key="DefaultGroupBoxStyle">
        <Setter Property="Padding" Value="{StaticResource GroupBoxContentPadding}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GroupBox">
                    <Grid>
                        <TextBlock x:Name="HeaderText" Text="{TemplateBinding Header}" />
                        <Border x:Name="MainBorder" Child="{TemplateBinding Content}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,0,1,1"/>
                        <Border x:Name="TopLeftBorder"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                HorizontalAlignment="Left"
                                BorderThickness="0,1,0,0" />
                        <Border x:Name="TopRightBorder"
                                BorderThickness="0,1,0,0"
                                HorizontalAlignment="Right"
                                BorderBrush="{TemplateBinding BorderBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:GroupBox" BasedOn="{StaticResource DefaultGroupBoxStyle}" />
</ResourceDictionary>
