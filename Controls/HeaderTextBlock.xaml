<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyDairy.Controls">

    <Style TargetType="local:HeaderTextBlock" x:Key="DefaultHeaderTextBlockStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HeaderTextBlock">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="{TemplateBinding Header}" />
                        <TextBlock Grid.Row="1" Text="{TemplateBinding Text}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:HeaderTextBlock" BasedOn="{StaticResource DefaultHeaderTextBlockStyle}" />
</ResourceDictionary>
