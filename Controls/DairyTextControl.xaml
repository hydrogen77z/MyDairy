<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MyDairy.Controls.DairyTextControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyDairy.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ContentBackgroundBrush}">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveKeyboardAcceleratorInvoked" />
    </UserControl.KeyboardAccelerators>
    
    <ContentPresenter Padding="16,8,16,16" x:Name="DairyPresenter" />
</UserControl>
